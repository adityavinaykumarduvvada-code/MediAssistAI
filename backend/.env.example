# Copy this file to .env and fill in your key(s) before running the backend.

# Which LLM backend to use: "gemini" (free, recommended default), "groq"
# (free, text-only, needs GEMINI_API_KEY too for the Image Agent), or
# "anthropic" (paid, highest quality).
LLM_PROVIDER=gemini

# --- Free option: Google AI Studio ---
# Get a key (no credit card) at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Free option: Groq (text only, very fast) ---
# Get a key (no credit card) at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# --- Paid option: Anthropic ---
ANTHROPIC_API_KEY=
TEXT_MODEL=claude-sonnet-4-6
VISION_MODEL=claude-sonnet-4-6

ENV=development
